PROJECT_NAME="AI/ML-Based Network Intrusion Detection System (NIDS)"
VERSION="0.1.0"
DEBUG=False
API_V1_STR="/api/v1"

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=nids_db

# Direct SQLAlchemy URI override (optional)
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg://postgres:your_postgres_password_here@localhost:5432/nids_db

# Packet Capture Engine Settings
CAPTURE_QUEUE_CAPACITY=10000
CAPTURE_PREVIEW_CAPACITY=50
CAPTURE_PROMISCUOUS=True
CAPTURE_STORE_PACKETS=False
